<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="521.0" prefWidth="772.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practica_hibernate_2.controller.LibroController">
    <children>
        <Label layoutX="22.0" layoutY="14.0" text="Registro de Libros">
            <font>
                <Font name="System Bold" size="21.0" />
            </font>
        </Label>
        <Label layoutX="22.0" layoutY="50.0" text="Titulo:" />
        <Label layoutX="22.0" layoutY="80.0" text="Autor:" />
        <Label layoutX="22.0" layoutY="111.0" text="Año:" />
        <Label layoutX="22.0" layoutY="149.0" text="Precio:" />
        <TextField fx:id="txtTitulo" layoutX="68.0" layoutY="46.0" />
        <TextField fx:id="txtAutor" layoutX="68.0" layoutY="76.0" />
        <TextField fx:id="txtAnio_publicacion" layoutX="68.0" layoutY="107.0" />
        <TextField fx:id="txtPrecio" layoutX="68.0" layoutY="144.0" />
        <Button fx:id="btnGuardar" layoutX="14.0" layoutY="189.0" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar Libro" />
        <Button fx:id="btnCargar" layoutX="121.0" layoutY="189.0" mnemonicParsing="false" onAction="#cargarLibros" text="Cargar Libros" />
        <TableView fx:id="tblLibros" layoutX="22.0" layoutY="239.0" prefHeight="252.0" prefWidth="728.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="38.39999580383301" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="223.99999237060547" text="Titutlo" />
                <TableColumn fx:id="colAutor" prefWidth="158.4000244140625" text="Autor" />
                <TableColumn fx:id="colAnio_publicacion" prefWidth="81.60006713867188" text="Año" />
                <TableColumn fx:id="colPrecio" minWidth="0.0" prefWidth="54.39996337890625" text="Precio" />
            <TableColumn fx:id="colCategoria" minWidth="0.0" prefWidth="172.800048828125" text="Categoría" />
            </columns>
        </TableView>
      <Button fx:id="btnModificar" layoutX="218.0" layoutY="188.0" mnemonicParsing="false" onAction="#modificarLibro" prefHeight="26.0" prefWidth="86.0" text="Modificar" />
      <Button fx:id="btnEliminar" layoutX="319.0" layoutY="188.0" mnemonicParsing="false" onAction="#eliminarLibro" prefHeight="26.0" prefWidth="86.0" text="Eliminar" />
      <Button fx:id="btnLimpiar" layoutX="418.0" layoutY="188.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="26.0" prefWidth="86.0" text="Limpiar" />
      <Label layoutX="268.0" layoutY="50.0" text="Categoría:" />
      <ComboBox fx:id="cmbCategorias" layoutX="330.0" layoutY="46.0" prefHeight="26.0" prefWidth="236.0" />
    </children>
</AnchorPane>
